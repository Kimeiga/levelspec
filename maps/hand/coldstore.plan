id: og_coldstore
name: Cold Store
description: Cold Store. A refrigerated store under a loading level, where every way down is a sealed door and the doors have been propped open long enough for it to matter. Built as a refrigerated distribution store; the plant tripped out and the seals were chocked open to vent it.

grid: 1.7
wall_thickness: 0.3

layer cold z=-4.6 height=4.00 roof=yes

legend
  A  compressors       "Compressors"  room  h=3.6
  B  antechamber       "Antechamber"  corridor  h=3.0
  C  chamber           "Cold Chamber"  site  h=4.0
  0  compressors_cover "Plant"  cover=1.7  as=barrel
  1  chamber_cover     "Racking"  cover=1.8  as=crate
end

