id: cs_pitstop_upper
name: Pitstop
description: Layout reconstruction of Pitstop, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Pitstop - Upper Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 41,42,42  value 0.17
  B  area_b  "Area B"  lane   // rgb 79,85,85  value 0.34
  C  area_c  "Area C"  lane   // rgb 104,111,112  value 0.44
end

