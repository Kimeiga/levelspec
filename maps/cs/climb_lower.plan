id: cs_climb_lower
name: Climb
description: Layout reconstruction of Climb, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Climb - Lower Radar.png
grid: 1.48
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 39,39,36  value 0.16
  B  area_b  "Area B"  lane  +0.42  // rgb 80,85,85  value 0.34
  C  area_c  "Area C"  lane  +0.84  // rgb 115,117,116  value 0.46
end

