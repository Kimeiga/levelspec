id: cs_cobblestone
name: Cobblestone
description: Layout reconstruction of Cobblestone, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Cobblestone - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 52,63,42  value 0.25
  B  area_b  "Area B"  lane  // rgb 67,69,43  value 0.27
  C  area_c  "Area C"  lane  +0.42  // rgb 78,72,37  value 0.31
  D  area_d  "Area D"  lane  +0.84  // rgb 92,80,44  value 0.36
end

