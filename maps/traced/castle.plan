id: cs_castle
name: Castle
description: Layout reconstruction of Castle, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Castle - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 36,37,39  value 0.15
  B  area_b  "Area B"  lane   // rgb 50,51,52  value 0.21
  C  area_c  "Area C"  lane   // rgb 69,67,63  value 0.27
  D  area_d  "Area D"  lane   // rgb 90,91,80  value 0.36
  E  area_e  "Area E"  lane   // rgb 124,117,102  value 0.49
end

