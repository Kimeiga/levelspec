id: cs_dust_ii_control
name: Dust II Control
description: Layout reconstruction of Dust II Control, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Dust II Control - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  B  area_b  "Area B"  lane   // rgb 102,107,100  value 0.42
  C  area_c  "Area C"  lane   // rgb 122,123,121  value 0.49
  D  area_d  "Area D"  lane   // rgb 143,143,142  value 0.56
  E  area_e  "Area E"  lane   // rgb 164,165,163  value 0.65
end

