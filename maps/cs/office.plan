id: cs_office
name: Office
description: Layout reconstruction of Office, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Office - Radar.png
grid: 1.42
wall_thickness: 0.37

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  B  area_b  "Area B"  lane  // rgb 47,64,80  value 0.32
  C  area_c  "Area C"  lane  +0.44  // rgb 77,57,64  value 0.30
  D  area_d  "Area D"  lane  +0.88  // rgb 71,69,74  value 0.29
end

