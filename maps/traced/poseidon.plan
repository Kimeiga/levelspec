id: cs_poseidon
name: Poseidon
description: Layout reconstruction of Poseidon, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Poseidon - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 130,109,92  value 0.51
  B  area_b  "Area B"  lane   // rgb 181,170,145  value 0.71
  C  area_c  "Area C"  lane   // rgb 202,191,167  value 0.80
end

