id: cs_chalice
name: Chalice
description: Layout reconstruction of Chalice, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Chalice - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 55,63,64  value 0.25
  B  area_b  "Area B"  lane   // rgb 73,66,59  value 0.29
  C  area_c  "Area C"  lane   // rgb 101,101,100  value 0.40
end

