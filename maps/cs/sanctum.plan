id: cs_sanctum
name: Sanctum
description: Layout reconstruction of Sanctum, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Sanctum - Radar.png
grid: 1.48
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 52,90,98  value 0.39
  B  area_b  "Area B"  lane  +0.42  // rgb 71,120,116  value 0.47
  C  area_c  "Area C"  lane  +0.84  // rgb 95,138,126  value 0.54
end

