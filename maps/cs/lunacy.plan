id: cs_lunacy
name: Lunacy
description: Layout reconstruction of Lunacy, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Lunacy - Radar.png
grid: 1.42
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 52,60,65  value 0.26
  C  area_c  "Area C"  lane  +0.44  // rgb 103,103,96  value 0.41
  D  area_d  "Area D"  lane  +0.88  // rgb 123,121,109  value 0.48
end

