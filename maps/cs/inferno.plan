id: cs_inferno
name: Inferno
description: Layout reconstruction of Inferno, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Inferno - Radar.png
grid: 1.48
wall_thickness: 0.29

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 29,58,58  value 0.23
  B  area_b  "Area B"  lane  +0.42  // rgb 49,58,62  value 0.25
  C  area_c  "Area C"  lane  +0.84  // rgb 69,69,69  value 0.27
end

