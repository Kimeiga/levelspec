id: cs_backalley
name: Backalley
description: Layout reconstruction of Backalley, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Backalley - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 70,71,70  value 0.28
  B  area_b  "Area B"  lane   // rgb 91,93,92  value 0.37
  C  area_c  "Area C"  lane   // rgb 109,112,110  value 0.44
  D  area_d  "Area D"  lane   // rgb 89,98,169  value 0.67
  E  area_e  "Area E"  lane   // rgb 132,140,136  value 0.55
end

