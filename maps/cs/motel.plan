id: cs_motel
name: Motel
description: Layout reconstruction of Motel, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Motel - Radar.png
grid: 1.42
wall_thickness: 0.38

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 50,54,63  value 0.25
  B  area_b  "Area B"  lane  // rgb 56,115,68  value 0.45
  C  area_c  "Area C"  lane  // rgb 86,148,90  value 0.58
  D  area_d  "Area D"  lane  +0.40  // rgb 119,124,124  value 0.49
end

