id: cs_chlorine
name: Chlorine
description: Layout reconstruction of Chlorine, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Chlorine - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 56,70,41  value 0.28
  B  area_b  "Area B"  lane   // rgb 85,102,54  value 0.40
  C  area_c  "Area C"  lane   // rgb 135,132,54  value 0.53
end

