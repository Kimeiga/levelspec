id: cs_anubis
name: Anubis
description: Layout reconstruction of Anubis, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Anubis - Radar.png
grid: 1.42
wall_thickness: 0.33

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=9.0  // rgb 120,102,84  value 0.47
  B  area_b  "Area B"  lane  h=7.8  // rgb 75,125,109  value 0.49
  C  area_c  "Area C"  lane  h=6.6  // rgb 167,134,91  value 0.66
  D  area_d  "Area D"  lane  h=5.5  // rgb 146,132,121  value 0.57
  E  area_e  "Area E"  lane  +0.40  h=4.3  // rgb 195,162,97  value 0.77
end

