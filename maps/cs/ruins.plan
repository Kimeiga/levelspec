id: cs_ruins
name: Ruins
description: Layout reconstruction of Ruins, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ruins - Radar.png
grid: 1.42
wall_thickness: 0.33

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  B  area_b  "Area B"  lane  h=6.2  // rgb 72,71,71  value 0.28
  C  area_c  "Area C"  lane  h=5.1  // rgb 86,87,85  value 0.34
  D  area_d  "Area D"  lane  h=4.0  // rgb 107,106,104  value 0.42
  E  area_e  "Area E"  lane  +0.40  h=2.9  // rgb 124,128,124  value 0.50
end

