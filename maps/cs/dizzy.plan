id: cs_dizzy
name: Dizzy
description: Layout reconstruction of Dizzy, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Dizzy - Radar.png
grid: 1.42
wall_thickness: 0.30

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=8.8  // rgb 58,59,58  value 0.23
  B  area_b  "Area B"  lane  h=7.6  // rgb 69,71,69  value 0.28
  C  area_c  "Area C"  lane  h=6.5  // rgb 83,85,83  value 0.33
  D  area_d  "Area D"  lane  +0.42  h=5.3  // rgb 94,96,94  value 0.38
  E  area_e  "Area E"  lane  +0.84  h=4.2  // rgb 88,142,88  value 0.56
end

