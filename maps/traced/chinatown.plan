id: cs_chinatown
name: Chinatown
description: Layout reconstruction of Chinatown, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Chinatown - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 89,77,76  value 0.35
  B  area_b  "Area B"  lane   // rgb 108,105,105  value 0.42
  C  area_c  "Area C"  lane   // rgb 99,146,106  value 0.57
  D  area_d  "Area D"  lane   // rgb 126,126,126  value 0.50
  E  area_e  "Area E"  lane   // rgb 146,146,146  value 0.57
end

