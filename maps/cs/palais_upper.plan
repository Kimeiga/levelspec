id: cs_palais_upper
name: Palais
description: Layout reconstruction of Palais, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Palais - Upper Radar.png
grid: 1.42
wall_thickness: 0.33

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 5,36,8  value 0.14
  C  area_c  "Area C"  lane  // rgb 41,79,79  value 0.31
  D  area_d  "Area D"  lane  +0.42  // rgb 47,85,82  value 0.34
  E  area_e  "Area E"  lane  +0.84  // rgb 50,91,85  value 0.36
end

