id: cs_museum
name: Museum
description: Layout reconstruction of Museum, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Museum - Radar.png
grid: 1.42
wall_thickness: 0.37

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 44,44,45  value 0.18
  B  area_b  "Area B"  lane  // rgb 76,78,77  value 0.31
  C  area_c  "Area C"  lane  // rgb 113,117,116  value 0.46
  D  area_d  "Area D"  lane  +0.42  // rgb 147,152,152  value 0.60
  E  area_e  "Area E"  lane  +0.84  // rgb 177,183,194  value 0.76
end

