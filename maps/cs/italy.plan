id: cs_italy
name: Italy
description: Layout reconstruction of Italy, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Italy - Radar.png
grid: 1.42
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 80,48,31  value 0.31
  B  area_b  "Area B"  lane  +0.44  // rgb 80,59,32  value 0.32
