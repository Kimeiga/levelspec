id: og_chillworks
name: Chill Works
description: Chill Works. A rail in the ceiling that runs through every room in the building in one order, and rooms that get colder the further along it you go. Built as a meat processing works; the line stopped between rooms and the doors were left hooked open.

grid: 1.6
wall_thickness: 0.28

layer drains z=-3.4 height=2.80 roof=no

legend
  A  drain_gallery     "Drain Gallery"  corridor  h=2.6
  B  rendering         "Rendering"  room  h=2.8
  0  rendering_cover   "Tanks"  cover=1.4  as=barrel
end

