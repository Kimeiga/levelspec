id: cs_engage
name: Engage
description: Layout reconstruction of Engage, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Engage - Radar.png
grid: 1.48
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 101,125,118  value 0.49
  B  area_b  "Area B"  lane  // rgb 116,143,135  value 0.56
  C  area_c  "Area C"  lane  +0.40  // rgb 132,159,153  value 0.63
end

