id: og_kiln
name: Kiln
description: Kiln. An original bomb-defusal map set in a disused brickworks. Attackers enter from the clay yard in the south. Bombsite A is the raised kiln hall, reached by the long western haul road or the short catwalk off mid. Bombsite B is the drying shed, reached through the low clay tunnels or up the conveyor line from mid. Defenders hold the office block to the north.

grid: 1.6
wall_thickness: 0.3

layer works z=0 height=6.0 roof=no

legend
  T  t_spawn        "Clay Yard"      spawn
  C  ct_spawn       "Office Block"   spawn    +1.2
  A  a_site         "Kiln Hall"      site     +1.2  h=7.0
  B  b_site         "Drying Shed"    site     +0.6  h=5.5
  R  ct_a           "Office Stairs"  corridor +1.2
  K  ct_b           "Loading Dock"   corridor +1.2
  j  dock_landing   "Dock Floor"     corridor +0.6
  k  dock_ramp      "Dock Ramp"      ramp
  n  mid_ramp       "Kiln Steps"     ramp
  M  mid            "Mid"            lane
  D  mid_doors      "Yard Gate"      corridor h=3.4
  S  short_a        "Catwalk"        corridor
  q  short_landing  "Catwalk Foot"   corridor
  s  short_ramp     "Catwalk Steps"  ramp
  W  conveyor       "Conveyor"       corridor h=4.0
  v  conveyor_foot  "Conveyor Foot"  corridor h=4.0
  w  conveyor_ramp  "Conveyor Ramp"  ramp
  O  outside_long   "Haul Road"      lane
  L  long_a         "Long"           lane
  P  long_corner    "Long Corner"    lane     +1.2
  l  long_ramp      "Long Ramp"      ramp
  U  tunnels        "Clay Tunnels"   corridor h=3.2
  u  tunnel_ramp    "Tunnel Ramp"    ramp
  0  a_cover        "Kiln Carts"     cover=1.4  as=crate
  1  b_cover        "Brick Pallets"  cover=1.2  as=crate
  2  mid_cover      "Clay Bins"      cover=2.2  as=crate
  3  t_cover        "Spoil Heaps"    cover=1.3  as=crate
end

