id: cs_palacio
name: Palacio
description: Layout reconstruction of Palacio, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Palacio - Radar.png
grid: 1.42
wall_thickness: 0.36

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 52,81,88  value 0.35
  C  area_c  "Area C"  lane  +0.44  // rgb 71,87,96  value 0.38
  D  area_d  "Area D"  lane  +0.88  // rgb 83,89,86  value 0.35
  E  area_e  "Area E"  lane  +1.32  // rgb 108,95,78  value 0.42
end

