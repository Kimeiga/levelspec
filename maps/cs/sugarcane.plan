id: cs_sugarcane
name: Sugarcane
description: Layout reconstruction of Sugarcane, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Sugarcane - Radar.png
grid: 1.48
wall_thickness: 0.39

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
