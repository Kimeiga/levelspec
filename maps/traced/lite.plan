id: cs_lite
name: Lite
description: Layout reconstruction of Lite, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Lite - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 98,93,93  value 0.39
  C  area_c  "Area C"  lane   // rgb 115,114,110  value 0.45
  D  area_d  "Area D"  lane   // rgb 134,133,125  value 0.53
end

