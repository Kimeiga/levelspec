id: cs_overpass
name: Overpass
description: Layout reconstruction of Overpass, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Overpass - Radar.png
grid: 1.48
wall_thickness: 0.36

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 86,86,84  value 0.34
  B  area_b  "Area B"  lane  +0.42  // rgb 112,108,104  value 0.44
  C  area_c  "Area C"  lane  +0.84  // rgb 149,136,115  value 0.59
end

