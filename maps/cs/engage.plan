id: cs_engage
name: Engage
description: Layout reconstruction of Engage, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Engage - Radar.png
grid: 1.42
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  B  area_b  "Area B"  lane  // rgb 111,132,127  value 0.52
  C  area_c  "Area C"  lane  +0.44  // rgb 114,146,136  value 0.57
  D  area_d  "Area D"  lane  +0.88  // rgb 126,149,143  value 0.59
  E  area_e  "Area E"  lane  +1.32  // rgb 133,161,155  value 0.64
end

