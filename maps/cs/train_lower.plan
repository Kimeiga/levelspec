id: cs_train_lower
name: Train
description: Layout reconstruction of Train, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Train - Lower Radar.png
grid: 1.48
wall_thickness: 0.41

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 87,73,58  value 0.34
  B  area_b  "Area B"  lane  // rgb 100,96,82  value 0.39
  C  area_c  "Area C"  lane  +0.40  // rgb 91,112,117  value 0.46
end

