id: cs_favela
name: Favela
description: Layout reconstruction of Favela, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Favela - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 69,71,70  value 0.28
  B  area_b  "Area B"  lane   // rgb 101,103,101  value 0.41
  C  area_c  "Area C"  lane   // rgb 124,123,123  value 0.49
  D  area_d  "Area D"  lane   // rgb 137,137,136  value 0.54
  E  area_e  "Area E"  lane   // rgb 153,150,149  value 0.60
end

