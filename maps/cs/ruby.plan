id: cs_ruby
name: Ruby
description: Layout reconstruction of Ruby, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ruby - Radar.png
grid: 1.42
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 128,127,124  value 0.50
  C  area_c  "Area C"  lane  // rgb 184,181,180  value 0.72
  D  area_d  "Area D"  lane  // rgb 227,180,157  value 0.89
  E  area_e  "Area E"  lane  +0.40  // rgb 191,212,182  value 0.83
end

