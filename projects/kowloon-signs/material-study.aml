  <material id="kit-rust" color="#ffffff" texture="../dressing-demo/textures/rust.png" repeat="2" roughness="0.96" metalness="0.05"/>
  <material id="kit-timber" color="#ffffff" texture="../dressing-demo/textures/timber.png" repeat="1.5" roughness="0.8"/>
  <material id="concrete" color="#bdc1bb" texture="../dressing-demo/textures/ground-concrete.png" repeat="1.2" roughness="0.94"/>
