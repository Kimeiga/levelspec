{
  "schema_version": "1.1",
  "id": "vertical_stack_tower",
  "name": "Vertical Stack Tower",
  "description": "Five stacked levels sharing one footprint, connected by alternating stair flights, a ramp, two ladders and four destructible hatches, with railed balconies on three sides and an open roof deck. Built to stress the vertical half of the compiler: floor holes, storey alignment, step geometry and cross-layer navigation.",
  "units": "meters",
  "coordinate_system": "right-handed Z-up",
  "grid": 1.0,
  "wall_thickness": 0.22,
  "floor_thickness": 0.2,
  "player": { "radius": 0.35, "height": 1.8, "step": 0.45, "crouch": 1.1 },

  "layers": [
    {
      "id": "l0",
      "label": "Level 0 — Lobby",
      "z": 0.0,
      "height": 3.2,
      "roof": false,
      "spaces": [
        { "id": "plaza", "label": "Plaza", "rect": [-8, -12, 40, 12], "role": "exterior" },
        { "id": "l0_main", "label": "Lobby", "rect": [0, 0, 20, 14], "role": "room" },
        { "id": "l0_stairs", "label": "Stair core 0", "rect": [6, 14, 8, 8], "role": "stairwell" }
      ],
      "portals": [
        { "id": "l0_core", "between": ["l0_main", "l0_stairs"], "kind": "arch", "width_cells": 3, "hint": [9, 14] },
        { "id": "l0_front", "between": ["l0_main", "plaza"], "kind": "door", "width_cells": 3, "hint": [8, 0] },
        { "id": "l0_west_window", "between": ["l0_main", "__outside__"], "kind": "window", "width_cells": 3, "side": "W", "hint": [0, 5] },
        { "id": "l0_east_window", "between": ["l0_main", "__outside__"], "kind": "window", "width_cells": 3, "side": "E", "hint": [20, 8] }
      ]
    },

    {
      "id": "l1",
      "label": "Level 1 — Offices",
      "z": 3.4,
      "height": 3.2,
      "spaces": [
        { "id": "l1_west", "label": "West office", "rect": [0, 0, 9, 14], "role": "room" },
        { "id": "l1_east", "label": "East office", "rect": [9, 0, 11, 14], "role": "room" },
        { "id": "l1_stairs", "label": "Stair core 1", "rect": [6, 14, 8, 8], "role": "stairwell" },
        { "id": "l1_balcony", "label": "South balcony", "rect": [0, -3, 20, 3], "role": "balcony", "railing": 1.15 }
      ],
      "portals": [
        { "id": "l1_split", "between": ["l1_west", "l1_east"], "kind": "door", "width_cells": 1, "hint": [9, 4] },
        { "id": "l1_core_w", "between": ["l1_west", "l1_stairs"], "kind": "arch", "width_cells": 2, "hint": [7, 14] },
        { "id": "l1_core_e", "between": ["l1_east", "l1_stairs"], "kind": "arch", "width_cells": 2, "hint": [12, 14] },
        { "id": "l1_bal_w", "between": ["l1_west", "l1_balcony"], "kind": "door", "width_cells": 2, "hint": [3, 0] },
        { "id": "l1_bal_e", "between": ["l1_east", "l1_balcony"], "kind": "door", "width_cells": 2, "hint": [15, 0] }
      ],
      "wall_overrides": [{ "between": ["l1_west", "l1_east"], "type": "soft" }]
    },

    {
      "id": "l2",
      "label": "Level 2 — Atrium",
      "z": 6.8,
      "height": 3.2,
      "spaces": [
        { "id": "l2_main", "label": "Atrium", "rect": [0, 0, 20, 14], "role": "room" },
        { "id": "l2_stairs", "label": "Stair core 2", "rect": [6, 14, 8, 8], "role": "stairwell" },
        { "id": "l2_balcony", "label": "East balcony", "rect": [20, 2, 4, 10], "role": "balcony", "railing": 1.15 }
      ],
      "portals": [
        { "id": "l2_core", "between": ["l2_main", "l2_stairs"], "kind": "arch", "width_cells": 3, "hint": [9, 14] },
        { "id": "l2_bal", "between": ["l2_main", "l2_balcony"], "kind": "door", "width_cells": 2, "hint": [20, 6] },
        { "id": "l2_west_window", "between": ["l2_main", "__outside__"], "kind": "rappel_window", "width_cells": 3, "side": "W", "hint": [0, 5], "barricade": true },
        { "id": "l2_south_window", "between": ["l2_main", "__outside__"], "kind": "rappel_window", "width_cells": 4, "side": "S", "hint": [7, 0], "barricade": true }
