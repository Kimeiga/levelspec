id: cs_shorttrain
name: Shorttrain
description: Layout reconstruction of Shorttrain, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Shorttrain - Radar.png
grid: 1.42
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=8.5  // rgb 46,47,46  value 0.19
  C  area_c  "Area C"  lane  h=7.0  // rgb 116,116,113  value 0.46
  D  area_d  "Area D"  lane  h=5.5  // rgb 112,177,112  value 0.70
  E  area_e  "Area E"  lane  +0.40  h=4.0  // rgb 134,134,133  value 0.53
end

