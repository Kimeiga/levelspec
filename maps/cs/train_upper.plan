id: cs_train_upper
name: Train
description: Layout reconstruction of Train, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Train - Upper Radar.png
grid: 1.48
wall_thickness: 0.33

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 101,82,64  value 0.40
  B  area_b  "Area B"  lane  // rgb 98,100,87  value 0.40
  C  area_c  "Area C"  lane  +0.40  // rgb 92,113,118  value 0.46
end

