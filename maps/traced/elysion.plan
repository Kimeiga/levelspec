id: cs_elysion
name: Elysion
description: Layout reconstruction of Elysion, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Elysion - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 55,71,72  value 0.28
  B  area_b  "Area B"  lane   // rgb 85,98,96  value 0.39
  C  area_c  "Area C"  lane   // rgb 173,169,168  value 0.68
end

