id: cs_studio
name: Studio
description: Layout reconstruction of Studio, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Studio - Radar.png
grid: 1.42
wall_thickness: 0.38

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 36,60,63  value 0.25
  B  area_b  "Area B"  lane  // rgb 44,70,69  value 0.28
  C  area_c  "Area C"  lane  // rgb 66,78,79  value 0.31
  D  area_d  "Area D"  lane  +0.40  // rgb 87,91,88  value 0.36
end

