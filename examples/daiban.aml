<?xml version="1.0" encoding="UTF-8"?>
<architecture version="1" id="daiban-courtyard" name="Daiban — bounded native courtyard study" validation="premap" curve-tolerance="0.003" description="Source-led capability study; dimensions estimated. Unknown exits are study cuts. Historical R19 fidelity hold unchanged.">
