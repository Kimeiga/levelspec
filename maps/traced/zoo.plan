id: cs_zoo
name: Zoo
description: Layout reconstruction of Zoo, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Zoo - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 62,74,71  value 0.29
  B  area_b  "Area B"  lane   // rgb 112,114,112  value 0.45
  C  area_c  "Area C"  lane   // rgb 131,128,128  value 0.52
end

