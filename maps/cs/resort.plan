id: cs_resort
name: Resort
description: Layout reconstruction of Resort, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Resort - Radar.png
grid: 1.48
wall_thickness: 0.30

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 51,52,51  value 0.21
  B  area_b  "Area B"  lane  // rgb 118,119,118  value 0.47
  C  area_c  "Area C"  lane  +0.40  // rgb 153,153,150  value 0.60
end

