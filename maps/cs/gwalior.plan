id: cs_gwalior
name: Gwalior
description: Layout reconstruction of Gwalior, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Gwalior - Radar.png
grid: 1.48
wall_thickness: 0.33

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
