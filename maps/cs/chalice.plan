id: cs_chalice
name: Chalice
description: Layout reconstruction of Chalice, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Chalice - Radar.png
grid: 1.42
wall_thickness: 0.38

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 51,61,65  value 0.26
  B  area_b  "Area B"  lane  +0.44  // rgb 62,65,64  value 0.26
  C  area_c  "Area C"  lane  +0.88  // rgb 70,66,60  value 0.28
  D  area_d  "Area D"  lane  +1.32  // rgb 78,66,58  value 0.31
end

