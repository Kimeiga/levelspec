id: cs_monastery
name: Monastery
description: Layout reconstruction of Monastery, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Monastery - Radar.png
grid: 1.42
wall_thickness: 0.39

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 64,65,64  value 0.26
  B  area_b  "Area B"  lane  // rgb 75,76,75  value 0.30
  C  area_c  "Area C"  lane  // rgb 88,89,88  value 0.35
  D  area_d  "Area D"  lane  +0.42  // rgb 101,103,101  value 0.40
  E  area_e  "Area E"  lane  +0.84  // rgb 118,120,118  value 0.47
end

