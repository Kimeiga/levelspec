id: cs_empire
name: Empire
description: Layout reconstruction of Empire, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Empire - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 58,56,54  value 0.23
  B  area_b  "Area B"  lane   // rgb 87,89,86  value 0.35
  C  area_c  "Area C"  lane   // rgb 114,119,114  value 0.47
  D  area_d  "Area D"  lane   // rgb 149,151,149  value 0.59
  E  area_e  "Area E"  lane   // rgb 189,190,189  value 0.75
end

