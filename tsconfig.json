{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/vector/**/*.ts",
    "src/lighting/**/*.ts",
    "viewer/**/*.ts",
    "tools/vector*.ts",
    "tests/vector*.ts",
    "src/vendor.d.ts",
    "src/export/vector/**/*.ts",
    "tools/export/**/*.ts",
    "vite.config.ts",
    "website/**/*.ts",
    "vite.website.config.ts",
    "tools/site*.ts",
    "src/reconstruction/**/*.ts",
    "tools/reconstruct*.ts",
    "tools/game-export.ts",
    "game/**/*.ts",
    "vite.game.config.ts",
    "tests/game-*.ts",
    "tests/plan-pipeline.test.ts"
  ]
}
