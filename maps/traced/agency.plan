id: cs_agency
name: Agency
description: Layout reconstruction of Agency, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Agency - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 75,56,64  value 0.30
  B  area_b  "Area B"  lane   // rgb 56,68,86  value 0.34
  C  area_c  "Area C"  lane   // rgb 70,65,78  value 0.31
  D  area_d  "Area D"  lane   // rgb 92,65,61  value 0.36
  E  area_e  "Area E"  lane   // rgb 64,77,99  value 0.39
end

