id: cs_warden
name: Warden
description: Layout reconstruction of Warden, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Warden - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 49,73,75  value 0.30
  B  area_b  "Area B"  lane   // rgb 76,84,77  value 0.33
  C  area_c  "Area C"  lane   // rgb 104,91,77  value 0.41
  D  area_d  "Area D"  lane   // rgb 117,96,81  value 0.46
end

