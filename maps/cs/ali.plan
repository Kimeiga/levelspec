id: cs_ali
name: Ali
description: Layout reconstruction of Ali, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ali - Radar.png
grid: 1.42
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=6.8  // rgb 38,38,38  value 0.15
  C  area_c  "Area C"  lane  +0.44  h=5.6  // rgb 88,87,85  value 0.35
  D  area_d  "Area D"  lane  +0.88  h=4.4  // rgb 114,115,110  value 0.45
  E  area_e  "Area E"  lane  +1.32  h=3.2  // rgb 142,142,142  value 0.56
end

