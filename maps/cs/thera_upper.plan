id: cs_thera_upper
name: Thera
description: Layout reconstruction of Thera, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Thera - Upper Radar.png
grid: 1.42
wall_thickness: 0.26

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 37,36,45  value 0.18
  C  area_c  "Area C"  lane  +0.44  // rgb 108,103,128  value 0.50
  D  area_d  "Area D"  lane  +0.88  // rgb 99,114,143  value 0.56
  E  area_e  "Area E"  lane  +1.32  // rgb 118,132,158  value 0.62
end

