id: cs_climb_upper
name: Climb
description: Layout reconstruction of Climb, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Climb - Upper Radar.png
grid: 1.42
wall_thickness: 0.36

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  C  area_c  "Area C"  lane  // rgb 110,90,60  value 0.43
  D  area_d  "Area D"  lane  +0.44  // rgb 108,101,64  value 0.43
end

