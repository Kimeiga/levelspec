id: cs_chlorine
name: Chlorine
description: Layout reconstruction of Chlorine, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Chlorine - Radar.png
grid: 1.42
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 48,60,35  value 0.24
  B  area_b  "Area B"  lane  +0.44  // rgb 69,88,50  value 0.35
  C  area_c  "Area C"  lane  +0.88  // rgb 89,106,54  value 0.42
  D  area_d  "Area D"  lane  +1.32  // rgb 120,121,53  value 0.48
  E  area_e  "Area E"  lane  +1.76  // rgb 152,144,57  value 0.60
end

