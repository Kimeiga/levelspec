id: cs_nuke_upper
name: Nuke
description: Layout reconstruction of Nuke, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Nuke - Upper Radar.png
grid: 1.48
wall_thickness: 0.37

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 129,134,134  value 0.53
  B  area_b  "Area B"  lane  // rgb 137,153,151  value 0.60
  C  area_c  "Area C"  lane  +0.40  // rgb 172,161,137  value 0.68
end

