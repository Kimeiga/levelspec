id: cs_aztec
name: Aztec
description: Layout reconstruction of Aztec, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Aztec - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 42,44,42  value 0.17
  B  area_b  "Area B"  lane   // rgb 75,75,73  value 0.30
  C  area_c  "Area C"  lane   // rgb 115,112,110  value 0.45
  D  area_d  "Area D"  lane   // rgb 109,140,96  value 0.55
  E  area_e  "Area E"  lane   // rgb 135,135,133  value 0.53
end

