id: cs_stronghold
name: Stronghold
description: Layout reconstruction of Stronghold, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Stronghold - Radar.png
grid: 1.42
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 96,112,88  value 0.44
  B  area_b  "Area B"  lane  +0.44  // rgb 114,128,103  value 0.50
  C  area_c  "Area C"  lane  +0.88  // rgb 128,140,116  value 0.55
  D  area_d  "Area D"  lane  +1.32  // rgb 144,154,131  value 0.60
  E  area_e  "Area E"  lane  +1.76  // rgb 160,167,146  value 0.66
end

