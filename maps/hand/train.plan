  Q  electrical        "Electrical"  room  +0.35  h=5.2
  R  a_ramp            "A Ramp"  lane  +0.35  h=5.4
  S  alley             "Alley"  corridor  +0.35  h=4.6
  0  blue_train        "Blue Train"  cover=1.9 as=vehicle
  1  red_train         "Red Train"  cover=1.9 as=vehicle
  2  yellow_train      "Yellow Train"  cover=1.9 as=vehicle
  3  orange_train      "Orange Train"  cover=1.9 as=vehicle
  4  bomb_train        "Bomb Train"  cover=1.9 as=vehicle
  5  b_wagon           "Wagon"  cover=1.9 as=vehicle
  6  b_flat            "Flatbed"  cover=1.3 as=crate
  7  green_boxes       "Green Boxes"  cover=1.4 as=crate
end

