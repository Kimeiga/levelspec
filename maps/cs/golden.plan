id: cs_golden
name: Golden
description: Layout reconstruction of Golden, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Golden - Radar.png
grid: 1.48
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 62,65,79  value 0.31
  B  area_b  "Area B"  lane  // rgb 91,80,85  value 0.36
  C  area_c  "Area C"  lane  +0.40  // rgb 153,150,153  value 0.60
end

