  P  pit               "Pit"  lane  -0.90  h=5.2
  C  long_corner       "Long Corner"  lane  +0.80  h=6.0
  A  a_site            "A Site"  site  +1.70  h=8.0
  X  a_cross           "A Cross"  lane  +1.30  h=6.4
  S  a_short           "A Short"  corridor  +1.30  h=4.6
  K  catwalk           "Catwalk"  balcony  +0.90  h=5.4
  d  mid_doors         "Mid Doors"  corridor  +0.40  h=3.8
  M  mid               "Mid"  lane  +0.40  h=7.6
  p  top_mid           "Top Mid"  lane  +0.80  h=6.8
  E  ct_mid            "CT Mid"  lane  +1.30  h=6.4
  Z  ct_spawn          "CT Spawn"  spawn  +1.70  h=7.4
  W  mid_to_b          "Mid to B"  corridor  +0.40  h=4.4
  u  lower_tunnels     "Lower Tunnels"  corridor  h=4.6
  U  upper_tunnels     "Upper Tunnels"  corridor  +0.40  h=4.8
  B  b_doors           "B Doors"  corridor  +1.20  h=4.0
  b  b_site            "B Site"  site  +0.85  h=7.2
  G  b_plat            "Back Plat"  site  +1.20  h=5.6
  /  pit_ramp          "Pit Ramp"  ramp
  \  a_ramp            "Ramp to A"  ramp
  x  a_boxes           "Boxes"  cover=1.5 as=crate
  o  b_barrels         "Barrels"  cover=1.2 as=crate
  c  mid_car           "Car"  cover=1.3 as=crate
  k  long_crate        "Long Crate"  cover=1.4 as=crate
  t  t_crates          "Crates"  cover=1.3 as=crate
end

