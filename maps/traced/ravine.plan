id: cs_ravine
name: Ravine
description: Layout reconstruction of Ravine, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ravine - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 60,77,81  value 0.32
  B  area_b  "Area B"  lane   // rgb 89,99,99  value 0.39
  C  area_c  "Area C"  lane   // rgb 146,129,112  value 0.57
end

