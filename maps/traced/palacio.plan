id: cs_palacio
name: Palacio
description: Layout reconstruction of Palacio, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Palacio - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 55,80,88  value 0.35
  B  area_b  "Area B"  lane   // rgb 74,87,92  value 0.36
  C  area_c  "Area C"  lane   // rgb 105,93,78  value 0.41
end

