{
  "name": "levelspec",
  "version": "1.0.0",
  "type": "module",
  "description": "Semantic level specs compiled to validated, playable geometry.",
  "exports": {
    ".": "./src/architecture/index.ts",
    "./migration": "./src/architecture/migration.ts",
    "./generate": "./src/generate/vector.ts",
    "./producers": "./src/architecture/producer.ts",
    "./trace": "./src/tracing/native.ts",
    "./lighting": "./src/lighting/bake.ts",
    "./export": "./src/export/vector/index.ts",
    "./reconstruction": "./src/reconstruction/index.ts"
  },
  "scripts": {
    "compile": "node bin/levelspec.mjs build",
    "gen": "node tools/generate.ts",
    "trace": "node tools/trace.ts",
    "test:producers": "node --test --test-concurrency=2 tests/producers/*.test.ts",
    "test": "node --test --test-concurrency=2 \"tests/*.test.ts\"",
    "dev": "vite",
    "build:viewer": "vite build",
    "check": "tsc --noEmit",
    "test:vector": "node --test --test-concurrency=2 \"tests/vector*.test.ts\"",
    "bake:vector": "node tools/vector-bake.ts",
    "test:export": "node --test tests/vector-export.test.ts",
    "dev:site": "vite --config vite.website.config.ts",
    "build:site": "vite build --config vite.website.config.ts",
    "preview:site": "vite preview --config vite.website.config.ts",
    "test:site": "node --test --test-concurrency=2 website/tests/*.test.ts",
    "test:site:browser": "node website/tests/review-browser.mjs",
    "bake:site": "node tools/site-bake.ts",
    "package:site-bakes": "node tools/site-package-bakes.ts",
    "reference:rooftop": "node tools/vector-rooftop-reference.ts",
    "reconstruct": "node tools/reconstruct.ts",
    "game:export": "node tools/game-export.ts",
    "game:dev": "vite --config vite.game.config.ts",
    "game:build": "vite build --config vite.game.config.ts",
    "levelspec": "node bin/levelspec.mjs",
    "test:preview:browser": "node tests/preview-browser.mjs && node tests/suggestions-browser.mjs && node tests/appearance-browser.mjs && node tests/normal-material-browser.mjs && node tests/shadows-browser.mjs && node tests/frame-aspect-browser.mjs && node tests/overlaps-browser.mjs && node tests/walk-inspection-browser.mjs && node tests/navigation-cell-browser.mjs",
    "test:normal-material:browser": "node tests/normal-material-browser.mjs",
    "test:walk:browser": "node tests/walk-inspection-browser.mjs",
    "test:review:browser": "node website/tests/review-browser.mjs",
    "capture:level": "node tools/capture-level.mjs",
    "test:capture:browser": "node tests/capture-level-browser.mjs",
    "test:circulation:browser": "node tests/aml-circulation-browser.mjs",
    "test:architecture:browser": "node tests/aml-cad-browser.mjs",
    "test:terrain:browser": "node tests/aml-terrain-browser.mjs",
    "explore": "node tools/fps/explore.ts",
    "dev:explore": "vite --config vite.explore.config.ts",
    "build:explore": "vite build --config vite.explore.config.ts",
    "test:explore": "node --test tests/producers/exploration*.test.ts",
    "test:explore:browser": "node tests/exploration-browser.mjs",
    "test:dressing:browser": "node tests/dressing-browser.mjs",
    "predemo:build": "node tools/build-concrete-maps.mjs",
    "demo:build": "node tools/build-dressing-demo.ts",
    "profile:dressing": "node tools/profile-dressing.ts",
    "predev": "npm run --silent demo:build",
    "predev:site": "npm run --silent demo:build",
    "prebuild:viewer": "npm run --silent demo:build",
    "prebuild:site": "npm run --silent demo:build"
  },
  "dependencies": {
    "cdt2d": "^1.0.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "manifold-3d": "^3.5.3",
    "pngjs": "^7.0.0",
    "recast-navigation": "^0.43.1",
    "saxes": "^6.0.0",
    "three": "^0.186.0",
    "xatlas-wasm": "^0.1.3"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.20.3",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "axe-core": "^4.13.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "bin": {
    "levelspec": "./bin/levelspec.mjs"
  }
}
