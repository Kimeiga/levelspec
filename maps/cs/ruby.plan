id: cs_ruby
name: Ruby
description: Layout reconstruction of Ruby, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ruby - Radar.png
grid: 1.48
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 129,129,125  value 0.51
  B  area_b  "Area B"  lane  // rgb 187,180,178  value 0.74
  C  area_c  "Area C"  lane  +0.40  // rgb 191,212,181  value 0.83
end

