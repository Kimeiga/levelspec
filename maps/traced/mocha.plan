id: cs_mocha
name: Mocha
description: Layout reconstruction of Mocha, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Mocha - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 58,73,77  value 0.30
  B  area_b  "Area B"  lane   // rgb 71,78,79  value 0.31
  C  area_c  "Area C"  lane   // rgb 96,91,84  value 0.38
end

