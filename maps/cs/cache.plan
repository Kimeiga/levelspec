id: cs_cache
name: Cache
description: Layout reconstruction of Cache, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Cache - Radar.png
grid: 1.42
wall_thickness: 0.28

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 167,119,93  value 0.66
