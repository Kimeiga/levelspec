id: cs_assault
name: Assault
description: Layout reconstruction of Assault, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Assault - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 34,45,56  value 0.22
  B  area_b  "Area B"  lane  // rgb 65,40,51  value 0.26
  C  area_c  "Area C"  lane  +0.40  // rgb 64,67,78  value 0.31
end

