id: cs_iris
name: Iris
description: Layout reconstruction of Iris, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Iris - Radar.png
grid: 1.48
wall_thickness: 0.29

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 119,69,33  value 0.47
  B  area_b  "Area B"  lane  // rgb 79,131,35  value 0.52
  C  area_c  "Area C"  lane  +0.40  // rgb 154,108,41  value 0.61
end

