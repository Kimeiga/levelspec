id: cs_tuscan
name: Tuscan
description: Layout reconstruction of Tuscan, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Tuscan - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 59,70,76  value 0.30
  B  area_b  "Area B"  lane   // rgb 75,78,77  value 0.31
  D  area_d  "Area D"  lane   // rgb 96,85,81  value 0.38
end

