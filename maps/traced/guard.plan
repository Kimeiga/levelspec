id: cs_guard
name: Guard
description: Layout reconstruction of Guard, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Guard - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 68,90,89  value 0.35
  B  area_b  "Area B"  lane   // rgb 82,116,109  value 0.46
  C  area_c  "Area C"  lane   // rgb 123,110,108  value 0.48
end

