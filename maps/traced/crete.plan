id: cs_crete
name: Crete
description: Layout reconstruction of Crete, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Crete - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 48,59,67  value 0.26
  B  area_b  "Area B"  lane   // rgb 47,93,68  value 0.37
  C  area_c  "Area C"  lane   // rgb 66,80,90  value 0.35
  D  area_d  "Area D"  lane   // rgb 74,103,106  value 0.42
  E  area_e  "Area E"  lane   // rgb 95,126,136  value 0.54
end

