id: cs_seaside
name: Seaside
description: Layout reconstruction of Seaside, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Seaside - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 57,55,48  value 0.23
  B  area_b  "Area B"  lane   // rgb 110,102,88  value 0.43
  D  area_d  "Area D"  lane   // rgb 158,143,122  value 0.62
  E  area_e  "Area E"  lane   // rgb 189,179,157  value 0.74
end

