id: cs_thera_upper
name: Thera
description: Layout reconstruction of Thera, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Thera - Upper Radar.png
grid: 1.48
wall_thickness: 0.26

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 41,41,51  value 0.20
  B  area_b  "Area B"  lane  // rgb 103,103,129  value 0.51
  C  area_c  "Area C"  lane  +0.40  // rgb 106,120,149  value 0.59
end

