id: cs_extraction
name: Extraction
description: Layout reconstruction of Extraction, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Extraction - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=7.1  // rgb 50,66,56  value 0.26
  B  area_b  "Area B"  lane  +0.44  h=6.2  // rgb 104,140,116  value 0.55
  C  area_c  "Area C"  lane  +0.88  h=5.2  // rgb 146,163,157  value 0.64
  D  area_d  "Area D"  lane  +1.32  h=4.3  // rgb 160,178,184  value 0.72
  E  area_e  "Area E"  lane  +1.76  h=3.4  // rgb 184,196,205  value 0.81
end

