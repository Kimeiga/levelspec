id: cs_ali
name: Ali
description: Layout reconstruction of Ali, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Ali - Radar.png
grid: 1.48
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 43,44,43  value 0.17
  B  area_b  "Area B"  lane  +0.42  // rgb 92,92,89  value 0.36
  C  area_c  "Area C"  lane  +0.84  // rgb 129,130,128  value 0.51
end

