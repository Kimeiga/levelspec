id: cs_mirage
name: Mirage
description: Layout reconstruction of Mirage, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Mirage - Radar.png
grid: 1.42
wall_thickness: 0.40

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=8.4  // rgb 53,71,77  value 0.30
  C  area_c  "Area C"  lane  h=7.0  // rgb 67,75,79  value 0.31
  D  area_d  "Area D"  lane  +0.42  h=5.5  // rgb 87,86,84  value 0.34
  E  area_e  "Area E"  lane  +0.84  h=4.0  // rgb 111,99,92  value 0.44
end

