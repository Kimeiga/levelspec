id: cs_motel
name: Motel
description: Layout reconstruction of Motel, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Motel - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 47,70,58  value 0.28
  B  area_b  "Area B"  lane   // rgb 96,117,105  value 0.46
  C  area_c  "Area C"  lane   // rgb 134,135,136  value 0.54
end

