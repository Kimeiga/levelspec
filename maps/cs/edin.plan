id: cs_edin
name: Edin
description: Layout reconstruction of Edin, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Edin - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=6.2  // rgb 54,63,79  value 0.31
  B  area_b  "Area B"  lane  h=5.1  // rgb 76,59,68  value 0.30
  C  area_c  "Area C"  lane  +0.42  h=4.0  // rgb 67,70,86  value 0.34
  D  area_d  "Area D"  lane  +0.84  h=2.9  // rgb 64,78,100  value 0.39
end

