id: cs_subzero
name: Subzero
description: Layout reconstruction of Subzero, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Subzero - Radar.png
grid: 1.42
wall_thickness: 0.31

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=6.1  // rgb 53,73,84  value 0.33
  B  area_b  "Area B"  lane  h=5.0  // rgb 68,75,83  value 0.33
  C  area_c  "Area C"  lane  +0.42  h=3.9  // rgb 75,84,91  value 0.36
  D  area_d  "Area D"  lane  +0.84  h=2.9  // rgb 93,88,87  value 0.37
end

