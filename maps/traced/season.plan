id: cs_season
name: Season
description: Layout reconstruction of Season, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Season - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 64,65,64  value 0.26
  B  area_b  "Area B"  lane   // rgb 102,101,97  value 0.40
  C  area_c  "Area C"  lane   // rgb 125,129,121  value 0.51
  D  area_d  "Area D"  lane   // rgb 151,150,149  value 0.59
  E  area_e  "Area E"  lane   // rgb 175,176,175  value 0.69
end

