id: cs_phoenix_compound
name: Phoenix Compound
description: Layout reconstruction of Phoenix Compound, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Phoenix Compound - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 40,42,48  value 0.19
  B  area_b  "Area B"  lane   // rgb 72,73,74  value 0.29
  C  area_c  "Area C"  lane   // rgb 88,89,91  value 0.36
  D  area_d  "Area D"  lane   // rgb 110,110,110  value 0.43
end

