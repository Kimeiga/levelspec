id: cs_basalt
name: Basalt
description: Layout reconstruction of Basalt, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Basalt - Radar.png
grid: 1.42
wall_thickness: 0.40

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=6.3  // rgb 56,54,65  value 0.26
  B  area_b  "Area B"  lane  h=5.2  // rgb 56,67,76  value 0.30
  C  area_c  "Area C"  lane  h=4.1  // rgb 65,82,85  value 0.33
  D  area_d  "Area D"  lane  +0.40  h=3.0  // rgb 79,94,92  value 0.37
end

