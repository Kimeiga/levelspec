id: cs_abbey
name: Abbey
description: Layout reconstruction of Abbey, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Abbey - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 43,59,62  value 0.25
  B  area_b  "Area B"  lane   // rgb 54,60,62  value 0.24
  C  area_c  "Area C"  lane   // rgb 60,65,65  value 0.26
  D  area_d  "Area D"  lane   // rgb 74,68,66  value 0.29
  E  area_e  "Area E"  lane   // rgb 82,74,69  value 0.32
end

