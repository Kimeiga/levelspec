id: cs_thera_lower
name: Thera
description: Layout reconstruction of Thera, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Thera - Lower Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 35,37,46  value 0.18
  B  area_b  "Area B"  lane   // rgb 64,62,74  value 0.29
  C  area_c  "Area C"  lane   // rgb 106,106,130  value 0.51
end

