id: cs_rialto
name: Rialto
description: Layout reconstruction of Rialto, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Rialto - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 50,49,48  value 0.20
  B  area_b  "Area B"  lane   // rgb 100,102,102  value 0.40
  C  area_c  "Area C"  lane   // rgb 145,143,134  value 0.57
end

