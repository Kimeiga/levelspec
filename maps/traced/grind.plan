id: cs_grind
name: Grind
description: Layout reconstruction of Grind, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Grind - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 112,114,109  value 0.45
  B  area_b  "Area B"  lane   // rgb 147,146,144  value 0.58
  C  area_c  "Area C"  lane   // rgb 183,186,183  value 0.73
end

