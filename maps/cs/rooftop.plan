id: cs_rooftop
name: Rooftop
description: Layout reconstruction of Rooftop, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Rooftop - Radar.png
grid: 1.42
wall_thickness: 0.38

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 60,81,92  value 0.36
  C  area_c  "Area C"  lane  // rgb 72,94,107  value 0.42
  D  area_d  "Area D"  lane  +0.40  // rgb 75,102,116  value 0.46
end

