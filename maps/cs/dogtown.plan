id: cs_dogtown
name: Dogtown
description: Layout reconstruction of Dogtown, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Dogtown - Radar.png
grid: 1.42
wall_thickness: 0.39

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 38,74,96  value 0.38
  B  area_b  "Area B"  lane  +0.44  // rgb 51,87,111  value 0.44
  E  area_e  "Area E"  lane  +0.88  // rgb 135,160,181  value 0.71
end

