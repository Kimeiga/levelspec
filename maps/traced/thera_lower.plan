id: cs_thera_lower
name: Thera
description: Layout reconstruction of Thera, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Thera - Lower Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 36,34,43  value 0.17
  B  area_b  "Area B"  lane   // rgb 33,38,48  value 0.19
  E  area_e  "Area E"  lane   // rgb 107,108,133  value 0.52
end

