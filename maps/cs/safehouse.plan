id: cs_safehouse
name: Safehouse
description: Layout reconstruction of Safehouse, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Safehouse - Radar.png
grid: 1.48
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 39,40,39  value 0.16
  B  area_b  "Area B"  lane  +0.42  // rgb 54,55,54  value 0.22
  C  area_c  "Area C"  lane  +0.84  // rgb 87,92,75  value 0.36
end

