id: cs_marquis
name: Marquis
description: Layout reconstruction of Marquis, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Marquis - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

