id: cs_royal
name: Royal
description: Layout reconstruction of Royal, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Royal - Radar.png
grid: 1.42
wall_thickness: 0.35

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=7.2  // rgb 68,67,64  value 0.27
  C  area_c  "Area C"  lane  h=6.0  // rgb 170,174,174  value 0.69
  D  area_d  "Area D"  lane  h=4.7  // rgb 213,215,215  value 0.85
  E  area_e  "Area E"  lane  +0.40  h=3.4  // rgb 245,246,246  value 0.97
end

