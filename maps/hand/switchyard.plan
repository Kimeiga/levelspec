id: og_switchyard
name: Switchyard
description: Switchyard. An open switchyard nobody can cross unseen, over a cable basement that runs the whole length of it and has no windows at all. Built as a grid switching station; the yard was isolated for work and half of it is still live.

grid: 1.8
wall_thickness: 0.3

layer cables z=-4.4 height=3.40 roof=no

legend
  A  cable_run         "Cable Run"  corridor  h=2.8
  B  battery_room      "Battery Room"  room  h=3.2
  0  cable_run_cover   "Trays"  cover=1  as=barrel
  1  battery_room_cover "Cells"  cover=1.4  as=crate
end

