id: cs_bank
name: Bank
description: Layout reconstruction of Bank, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Bank - Radar.png
grid: 1.42
wall_thickness: 0.30

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=7.8  // rgb 57,57,57  value 0.22
  B  area_b  "Area B"  lane  h=6.8  // rgb 73,74,73  value 0.29
  C  area_c  "Area C"  lane  h=5.7  // rgb 85,116,72  value 0.46
  D  area_d  "Area D"  lane  h=4.7  // rgb 93,92,91  value 0.37
  E  area_e  "Area E"  lane  +0.40  h=3.7  // rgb 126,124,123  value 0.50
end

