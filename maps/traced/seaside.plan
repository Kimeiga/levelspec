id: cs_seaside
name: Seaside
description: Layout reconstruction of Seaside, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Seaside - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 67,63,55  value 0.26
  B  area_b  "Area B"  lane   // rgb 126,129,103  value 0.51
  C  area_c  "Area C"  lane   // rgb 182,169,146  value 0.71
end

