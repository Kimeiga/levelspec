id: cs_apollo
name: Apollo
description: Layout reconstruction of Apollo, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Apollo - Radar.png
grid: 1.48
wall_thickness: 0.34

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 74,78,78  value 0.31
  B  area_b  "Area B"  lane  +0.42  // rgb 99,91,81  value 0.39
  C  area_c  "Area C"  lane  +0.84  // rgb 106,98,83  value 0.42
end

