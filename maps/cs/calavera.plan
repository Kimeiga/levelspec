id: cs_calavera
name: Calavera
description: Layout reconstruction of Calavera, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Calavera - Radar.png
grid: 1.48
wall_thickness: 0.41

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 54,74,76  value 0.30
  B  area_b  "Area B"  lane  // rgb 87,89,77  value 0.35
  C  area_c  "Area C"  lane  +0.40  // rgb 135,132,130  value 0.53
end

