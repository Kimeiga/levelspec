id: cs_mutiny
name: Mutiny
description: Layout reconstruction of Mutiny, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Mutiny - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 43,59,67  value 0.26
  B  area_b  "Area B"  lane   // rgb 50,73,75  value 0.30
  C  area_c  "Area C"  lane   // rgb 69,78,78  value 0.31
  D  area_d  "Area D"  lane   // rgb 52,98,76  value 0.39
  E  area_e  "Area E"  lane   // rgb 97,94,88  value 0.38
end

