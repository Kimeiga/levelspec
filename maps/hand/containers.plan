id: og_containers
name: Container Yard
description: Container Yard. A site with no buildings on it, where every wall is a box that happens to be standing there, and the one room is a shed full of humming refrigerated units. Built as an inland container terminal; the stack plan was lost with the yard system and nothing has moved since.

grid: 1.8
wall_thickness: 0.3

layer yard_c z=0 height=6.00 roof=no

legend
  A  reefer_shed       "Reefer Shed"  room  h=5.0
  B  straddle_lane     "Straddle Lane"  site  h=6.0
  C  stack_a           "A Stack"  lane  h=6.0
  D  gate_lane         "Gate Lane"  spawn  h=6.0
  0  reefer_shed_cover "Units"  cover=1.6  as=barrel
  1  stack_a_cover     "Boxes"  cover=2.6  as=crate
  2  gate_lane_cover   "Boxes"  cover=2.4  as=crate
end

