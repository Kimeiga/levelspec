id: cs_grail
name: Grail
description: Layout reconstruction of Grail, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Grail - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 130,88,164  value 0.64
  B  area_b  "Area B"  lane   // rgb 85,119,190  value 0.75
  C  area_c  "Area C"  lane   // rgb 59,141,220  value 0.86
end

