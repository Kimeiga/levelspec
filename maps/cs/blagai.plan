id: cs_blagai
name: Blagai
description: Layout reconstruction of Blagai, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Blagai - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 51,50,45  value 0.20
  B  area_b  "Area B"  lane  // rgb 84,63,45  value 0.33
  D  area_d  "Area D"  lane  +0.42  // rgb 109,79,56  value 0.43
  E  area_e  "Area E"  lane  +0.84  // rgb 130,89,61  value 0.51
end

