        { "id": "l3_stairs", "label": "Stair core 3", "rect": [6, 14, 8, 8], "role": "stairwell" },
        { "id": "l3_balcony", "label": "West balcony", "rect": [-4, 2, 4, 10], "role": "balcony", "railing": 1.15 }
      ],
      "portals": [
        { "id": "l3_core", "between": ["l3_main", "l3_stairs"], "kind": "arch", "width_cells": 3, "hint": [9, 14] },
        { "id": "l3_bal", "between": ["l3_main", "l3_balcony"], "kind": "door", "width_cells": 2, "hint": [0, 6] },
        { "id": "l3_east_window", "between": ["l3_main", "__outside__"], "kind": "rappel_window", "width_cells": 3, "side": "E", "hint": [20, 8], "barricade": true }
      ]
    },

    {
      "id": "roof",
      "label": "Roof deck",
      "z": 13.6,
      "height": 3.0,
      "roof": false,
      "railing": 1.15,
      "spaces": [
        { "id": "roof_deck", "label": "Roof deck", "rect": [0, 0, 20, 14], "role": "roof" },
        { "id": "roof_house", "label": "Stair head", "rect": [6, 14, 8, 8], "role": "stairwell", "height": 3.0 }
      ],
      "portals": [
        { "id": "roof_core", "between": ["roof_deck", "roof_house"], "kind": "arch", "width_cells": 3, "hint": [9, 14] }
      ]
    }
  ],

