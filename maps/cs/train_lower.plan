id: cs_train_lower
name: Train
description: Layout reconstruction of Train, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Train - Lower Radar.png
grid: 1.42
wall_thickness: 0.41

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=8.9  // rgb 46,44,34  value 0.18
  B  area_b  "Area B"  lane  h=7.7  // rgb 93,78,63  value 0.37
  C  area_c  "Area C"  lane  h=6.6  // rgb 93,98,88  value 0.39
  D  area_d  "Area D"  lane  h=5.4  // rgb 118,93,70  value 0.46
  E  area_e  "Area E"  lane  +0.40  h=4.2  // rgb 90,113,118  value 0.46
end

