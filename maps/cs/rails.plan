id: cs_rails
name: Rails
description: Layout reconstruction of Rails, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Rails - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  B  area_b  "Area B"  lane  h=6.4  // rgb 143,146,141  value 0.57
  C  area_c  "Area C"  lane  +0.44  h=5.3  // rgb 175,176,173  value 0.69
  D  area_d  "Area D"  lane  +0.88  h=4.1  // rgb 201,203,196  value 0.80
  E  area_e  "Area E"  lane  +1.32  h=3.0  // rgb 220,220,220  value 0.87
end

