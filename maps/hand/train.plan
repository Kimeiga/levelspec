id: cs_train
name: Train
description: Train. Footprint traced from the published radar, then annotated by hand with the callouts, elevations and rolling stock the radar cannot carry. A topology reconstruction - proportions are approximate and no assets from the shipped game are used.
grid: 1.5
wall_thickness: 0.34

layer ground z=0 height=6.6 roof=no

legend
  A  t_spawn           "T Spawn"  spawn  +1.40  h=7.4
  B  upper_yard        "Upper"  lane  +1.40  h=8.6
