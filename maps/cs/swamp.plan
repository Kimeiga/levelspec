id: cs_swamp
name: Swamp
description: Layout reconstruction of Swamp, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Swamp - Radar.png
grid: 1.48
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 75,122,117  value 0.48
  B  area_b  "Area B"  lane  // rgb 136,137,116  value 0.54
  C  area_c  "Area C"  lane  +0.40  // rgb 167,166,155  value 0.66
end

