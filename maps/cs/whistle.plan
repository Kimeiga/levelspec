id: cs_whistle
name: Whistle
description: Layout reconstruction of Whistle, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Whistle - Radar.png
grid: 1.42
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 63,92,91  value 0.36
  B  area_b  "Area B"  lane  // rgb 99,88,65  value 0.39
  C  area_c  "Area C"  lane  // rgb 62,103,88  value 0.41
  D  area_d  "Area D"  lane  +0.40  // rgb 81,96,88  value 0.38
end

