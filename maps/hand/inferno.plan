  K  arch              "Arch"  corridor  +0.75  h=4.4
  L  a_site            "A Site"  site  +1.10  h=8.2
  M  apartments        "Apartments"  corridor  +1.10  h=4.2
  N  library           "Library"  room  +1.10  h=5.0
  P  ct_spawn          "CT Spawn"  spawn  +1.45  h=7.0
  Q  pit               "Pit"  lane  +0.75  h=5.2
  R  ruins             "Ruins"  lane  +0.75  h=6.0
  S  graveyard         "Graveyard"  lane  +1.10  h=6.6
  0  a_boxes           "Boxes"  cover=1.4 as=crate
  1  b_crates          "Crates"  cover=1.4 as=crate
  2  banana_car        "Car"  cover=1.6 as=vehicle
  3  mid_barrels       "Barrels"  cover=1.2 as=barrel
  4  t_crates          "Crates"  cover=1.3 as=crate
end

