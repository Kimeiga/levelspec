id: cs_museum
name: Museum
description: Layout reconstruction of Museum, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Museum - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 51,52,53  value 0.21
  B  area_b  "Area B"  lane   // rgb 111,116,114  value 0.46
  C  area_c  "Area C"  lane   // rgb 166,171,178  value 0.70
end

