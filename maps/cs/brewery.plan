id: cs_brewery
name: Brewery
description: Layout reconstruction of Brewery, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Brewery - Radar.png
grid: 1.42
wall_thickness: 0.41

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=8.0  // rgb 39,55,77  value 0.30
  B  area_b  "Area B"  lane  +0.44  h=7.0  // rgb 60,67,74  value 0.29
