id: cs_workout
name: Workout
description: Layout reconstruction of Workout, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Workout - Radar.png
grid: 1.42
wall_thickness: 0.30

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 50,48,46  value 0.20
  B  area_b  "Area B"  lane  +0.44  // rgb 85,57,47  value 0.33
  C  area_c  "Area C"  lane  +0.88  // rgb 82,73,60  value 0.32
  D  area_d  "Area D"  lane  +1.32  // rgb 89,88,58  value 0.35
end

