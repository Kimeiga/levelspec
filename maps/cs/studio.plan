id: cs_studio
name: Studio
description: Layout reconstruction of Studio, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Studio - Radar.png
grid: 1.48
wall_thickness: 0.38

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 41,66,67  value 0.27
  B  area_b  "Area B"  lane  // rgb 66,79,77  value 0.31
  C  area_c  "Area C"  lane  +0.40  // rgb 94,99,96  value 0.39
end

