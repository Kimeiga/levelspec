id: cs_lake
name: Lake
description: Layout reconstruction of Lake, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Lake - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 42,42,42  value 0.17
  B  area_b  "Area B"  lane   // rgb 61,61,61  value 0.24
  C  area_c  "Area C"  lane   // rgb 81,82,77  value 0.32
end

