id: cs_dust2_hand
name: Dust II
description: Dust II, authored by hand rather than traced. Every area carries the callout it is known by, at the elevation it has in the original, with ramps where the ramps are. A topology reconstruction from public knowledge of the layout - proportions are approximate and no assets from the shipped game are used.
grid: 2.2
wall_thickness: 0.36

layer ground z=0 height=6.5 roof=no

legend
  T  t_spawn           "T Spawn"  spawn  h=7.0
  N  outside_tunnels   "Outside Tunnels"  lane  h=6.4
  m  t_mid             "T Mid"  lane  h=7.2
  R  t_ramp            "T Ramp"  lane  +0.40  h=6.6
