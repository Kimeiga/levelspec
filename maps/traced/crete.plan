id: cs_crete
name: Crete
description: Layout reconstruction of Crete, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Crete - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 48,61,67  value 0.27
  B  area_b  "Area B"  lane   // rgb 67,89,93  value 0.37
  C  area_c  "Area C"  lane   // rgb 91,121,131  value 0.52
end

