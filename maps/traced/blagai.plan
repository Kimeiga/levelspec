id: cs_blagai
name: Blagai
description: Layout reconstruction of Blagai, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Blagai - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 53,52,45  value 0.21
  B  area_b  "Area B"  lane   // rgb 92,70,48  value 0.36
  C  area_c  "Area C"  lane   // rgb 119,85,59  value 0.47
end

