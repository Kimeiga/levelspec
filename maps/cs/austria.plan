id: cs_austria
name: Austria
description: Layout reconstruction of Austria, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Austria - Radar.png
grid: 1.48
wall_thickness: 0.36

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 113,122,92  value 0.48
  B  area_b  "Area B"  lane  // rgb 145,126,131  value 0.57
  C  area_c  "Area C"  lane  +0.40  // rgb 154,153,162  value 0.64
end

