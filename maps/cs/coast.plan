id: cs_coast
name: Coast
description: Layout reconstruction of Coast, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Coast - Radar.png
grid: 1.42
wall_thickness: 0.27

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=9.1  // rgb 76,72,71  value 0.30
  B  area_b  "Area B"  lane  h=7.5  // rgb 73,102,64  value 0.40
  C  area_c  "Area C"  lane  +0.42  h=5.9  // rgb 86,85,85  value 0.34
  E  area_e  "Area E"  lane  +0.84  h=4.3  // rgb 96,96,96  value 0.38
end

