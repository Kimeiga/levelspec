  <profile id="court" points="0 0; 6.4 0; 6.4 7.8; 0 7.8"><hole points="1.8 1.3; 1.8 4.3; 4.2 4.3; 4.2 1.3"/></profile>
  <profile id="lower-receiver" points="0 5.8; 6.4 5.8; 6.4 7.8; 0 7.8"/>
