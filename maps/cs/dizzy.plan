id: cs_dizzy
name: Dizzy
description: Layout reconstruction of Dizzy, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Dizzy - Radar.png
grid: 1.48
wall_thickness: 0.30

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 63,64,63  value 0.25
  B  area_b  "Area B"  lane  // rgb 80,82,80  value 0.32
  C  area_c  "Area C"  lane  +0.40  // rgb 92,103,92  value 0.40
end

