id: cs_mikla
name: Mikla
description: Layout reconstruction of Mikla, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Mikla - Radar.png
grid: 1.42
wall_thickness: 0.41

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  h=9.3  // rgb 87,88,86  value 0.35
  B  area_b  "Area B"  lane  h=8.1  // rgb 99,99,97  value 0.39
  C  area_c  "Area C"  lane  h=6.9  // rgb 114,115,110  value 0.45
  D  area_d  "Area D"  lane  +0.42  h=5.6  // rgb 134,134,131  value 0.53
  E  area_e  "Area E"  lane  +0.84  h=4.4  // rgb 157,157,157  value 0.62
end

