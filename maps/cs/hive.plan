id: cs_hive
name: Hive
description: Layout reconstruction of Hive, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Hive - Radar.png
grid: 1.48
wall_thickness: 0.29

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 38,60,57  value 0.24
  B  area_b  "Area B"  lane  +0.42  // rgb 59,98,99  value 0.39
  C  area_c  "Area C"  lane  +0.84  // rgb 169,130,22  value 0.67
end

