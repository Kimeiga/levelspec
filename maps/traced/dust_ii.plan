id: cs_dust_ii
name: Dust II
description: Layout reconstruction of Dust II, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Dust II - Radar.png
grid: 1.42
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
