id: cs_rails
name: Rails
description: Layout reconstruction of Rails, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Rails - Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 122,124,120  value 0.49
  B  area_b  "Area B"  lane   // rgb 176,177,173  value 0.70
  C  area_c  "Area C"  lane   // rgb 214,215,212  value 0.84
end

