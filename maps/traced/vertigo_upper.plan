id: cs_vertigo_upper
name: Vertigo
description: Layout reconstruction of Vertigo, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Vertigo - Upper Radar.png
grid: 1.48
wall_thickness: 0.32

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane   // rgb 35,24,29  value 0.14
  B  area_b  "Area B"  lane   // rgb 92,84,53  value 0.36
  C  area_c  "Area C"  lane   // rgb 111,109,103  value 0.44
end

