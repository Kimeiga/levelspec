id: cs_jura
name: Jura
description: Layout reconstruction of Jura, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Jura - Radar.png
grid: 1.48
wall_thickness: 0.37

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 54,62,51  value 0.25
  B  area_b  "Area B"  lane  +0.42  // rgb 91,103,82  value 0.41
  C  area_c  "Area C"  lane  +0.84  // rgb 116,131,104  value 0.52
end

