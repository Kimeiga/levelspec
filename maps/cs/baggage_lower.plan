id: cs_baggage_lower
name: Baggage
description: Layout reconstruction of Baggage, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Baggage - Lower Radar.png
grid: 1.42
wall_thickness: 0.39

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 40,40,40  value 0.16
  B  area_b  "Area B"  lane  // rgb 47,47,46  value 0.19
  C  area_c  "Area C"  lane  // rgb 56,55,54  value 0.22
  D  area_d  "Area D"  lane  +0.42  // rgb 77,67,61  value 0.31
  E  area_e  "Area E"  lane  +0.84  // rgb 99,85,75  value 0.39
end

