id: cs_aztec
name: Aztec
description: Layout reconstruction of Aztec, traced from the public radar image and then hand-corrected. Topology and proportions only - no assets from the original game are used.
source_image: Aztec - Radar.png
grid: 1.48
wall_thickness: 0.39

// TRACED DRAFT. The footprint is read from the radar; everything below
// needs a human: rename the areas, set their elevations, mark the spawns
// and sites, and delete any band that is really just shading.

layer ground z=0 height=5 roof=no

legend
  A  area_a  "Area A"  lane  // rgb 58,59,58  value 0.23
  B  area_b  "Area B"  lane  // rgb 106,113,98  value 0.44
  C  area_c  "Area C"  lane  +0.40  // rgb 127,128,124  value 0.50
end

