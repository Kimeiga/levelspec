  <marker id="middle-finish" kind="poi" element="middle-west-floor" position="0.7 6 4.8"/>
  <marker id="incline-start" kind="poi" element="incline-lower-landing" position="7.3 3 7.4"/>
  <marker id="incline-finish" kind="poi" element="incline-upper-landing" position="7.3 7.8 9.3"/>
  <route id="lower-flight-route" from="lower-start" to="lower-finish" min-routes="1" max-distance="9"/>
  <route id="near-flight-route" from="near-start" to="near-finish" min-routes="1" max-distance="9"/>
