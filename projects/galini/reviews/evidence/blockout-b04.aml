<?xml version="1.0" encoding="UTF-8"?>
<architecture version="1" id="de_galini" name="Galini · Greek Coastal Town / 5v5 Defusal" units="meters" validation="playable" description="L03 / B01. Original calm coastal cliff town, two bombsites and five spawns per side. Multiplayer rules and balance require destination-engine integration/playtests.">
